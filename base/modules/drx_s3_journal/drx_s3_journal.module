<?php

/**
 * @file
 * DrX S3 Journal module hooks.
 *
 * Emits one immutable JSON object to s3://$DRX_S3_BUCKET/<journal-prefix>/...
 * per file entity create/update/delete for the public:// and private://
 * streams. Strict audit: any write failure aborts the surrounding
 * Drupal request via an uncaught exception. Deletions are journaled by
 * JournalingFileStorage::delete() before core's File::preDelete() removes the
 * S3 object, so a failed journal write never leaves deleted content behind.
 */

declare(strict_types=1);

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\drx_s3_journal\Entity\JournalingFileStorage;
use Drupal\file\FileInterface;
use Drupal\file\FileStorage;

/**
 * Implements hook_help().
 */
function drx_s3_journal_help(string $route_name, RouteMatchInterface $route_match): string {
  if ($route_name === 'help.page.drx_s3_journal') {
    $prefix = (string) (getenv('DRX_S3_PREFIX_JOURNAL') ?: 'journal/v1');
    $prefix = trim($prefix, '/');
    if ($prefix === '') {
      $prefix = 'journal/v1';
    }
    return '<p>' . t(
      'Writes one immutable JSON event to the configured S3 bucket under the @prefix prefix on every file create/update/delete for public:// and private://. The journal is the source of truth for end-user content changes and is independent of the Drupal database.',
      ['@prefix' => $prefix . '/'],
    ) . '</p>';
  }
  return '';
}

/**
 * Implements hook_entity_insert().
 */
function drx_s3_journal_entity_insert(EntityInterface $entity): void {
  if ($entity instanceof FileInterface) {
    \Drupal::service('drx_s3_journal.journal')->record('create', $entity);
  }
}

/**
 * Implements hook_entity_update().
 */
function drx_s3_journal_entity_update(EntityInterface $entity): void {
  if ($entity instanceof FileInterface) {
    \Drupal::service('drx_s3_journal.journal')->record('update', $entity);
  }
}

/**
 * Implements hook_entity_type_alter().
 *
 * Swaps in a file storage handler that journals deletions before core's
 * File::preDelete() removes the S3 object. Only the stock core storage is
 * replaced; if another module already supplies a custom file storage class
 * the delete hook below remains the (post-removal) fallback.
 */
function drx_s3_journal_entity_type_alter(array &$entity_types): void {
  if (isset($entity_types['file']) && $entity_types['file']->getStorageClass() === FileStorage::class) {
    $entity_types['file']->setStorageClass(JournalingFileStorage::class);
  }
}

/**
 * Implements hook_entity_delete().
 *
 * Fallback only: deletions are normally journaled before removal by
 * JournalingFileStorage::delete(). When another module has replaced the
 * file storage class this records the event from the in-memory
 * FileInterface before Drupal removes the row, so the payload still has
 * uri/filename/mime/size for replay.
 */
function drx_s3_journal_entity_delete(EntityInterface $entity): void {
  if (!$entity instanceof FileInterface) {
    return;
  }
  if (\Drupal::entityTypeManager()->getStorage('file') instanceof JournalingFileStorage) {
    return;
  }
  \Drupal::service('drx_s3_journal.journal')->record('delete', $entity);
}
