<?xml version="1.0"?>
<ruleset name="drx-apiserver Drupal coding standards">
  <description>Drupal + DrupalPractice coding standards for custom application code.</description>

  <rule ref="Drupal"/>
  <rule ref="DrupalPractice"/>

  <arg name="extensions" value="php,module,inc,install,theme,profile,test"/>
  <arg name="basepath" value="."/>
  <arg value="sp"/>

  <exclude-pattern>base/vendor/*</exclude-pattern>
  <exclude-pattern>base/web/core/*</exclude-pattern>
  <exclude-pattern>base/web/modules/contrib/*</exclude-pattern>
  <exclude-pattern>base/web/themes/contrib/*</exclude-pattern>

  <file>server/modules/custom</file>
</ruleset>
