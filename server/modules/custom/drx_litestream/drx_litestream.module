<?php

/**
 * @file
 * DrX Litestream module hooks.
 */

declare(strict_types=1);

use Drupal\Core\Link;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Url;

/**
 * Implements hook_help().
 */
function drx_litestream_help(string $route_name, RouteMatchInterface $route_match): string {
  if ($route_name === 'help.page.drx_litestream') {
    return '<p>' . t('Surfaces litestream replication health and lets operators capture point-in-time markers for dev-machine restores. Requires the drx-apiserver base image with <code>DRX_LITESTREAM_ENABLED=1</code>.') . '</p>';
  }
  return '';
}

/**
 * Implements hook_requirements().
 */
function drx_litestream_requirements(string $phase): array {
  $requirements = [];
  if ($phase !== 'runtime') {
    return $requirements;
  }

  /** @var \Drupal\drx_litestream\Service\LitestreamStatus $status */
  $status = \Drupal::service('drx_litestream.status');
  /** @var \Drupal\drx_litestream\Service\RemoteReplica $remote */
  $remote = \Drupal::service('drx_litestream.remote_replica');
  $snapshot = $status->getHealthSnapshot();
  $remoteSize = $remote->getRemoteSize();
  $severityMap = [
    'healthy' => REQUIREMENT_OK,
    'degraded' => REQUIREMENT_WARNING,
    'disabled' => REQUIREMENT_WARNING,
    'failing' => REQUIREMENT_ERROR,
  ];
  $valueMap = [
    'healthy' => t('Healthy'),
    'degraded' => t('Degraded'),
    'disabled' => t('Disabled'),
    'failing' => t('Failing'),
  ];
  $state = $snapshot['state'];
  $severity = $severityMap[$state] ?? REQUIREMENT_WARNING;
  $value = $valueMap[$state] ?? t('Unknown');

  $details = [
    t('Daemon: @v', ['@v' => $snapshot['running'] ? 'running' : 'not running']),
    t('Local status: @v', ['@v' => $snapshot['local_status']]),
    t('WAL size: @v', ['@v' => $snapshot['wal_size']]),
    t('Computed remote size: @v', ['@v' => drx_litestream_format_remote_size_for_requirements($remoteSize)]),
    t('Replica URL: @v', ['@v' => $snapshot['replica_url']]),
  ];

  if (!empty($snapshot['issues'])) {
    $details[] = t('Issues: @v', ['@v' => implode('; ', $snapshot['issues'])]);
  }

  $details[] = Link::fromTextAndUrl(t('Open detailed litestream dashboard'), Url::fromRoute('drx_litestream.health'))->toString();

  $paragraph = implode('<br>', array_map(
    static fn($line) => (string) $line,
    $details,
  ));

  $requirements['drx_litestream_replication'] = [
    'title' => t('DrX Litestream replication'),
    'value' => $value,
    'severity' => $severity,
    'description' => [
      '#markup' => '<p>' . $paragraph . '</p>',
    ],
  ];

  return $requirements;
}

/**
 * Formats remote backup size for status report details.
 *
 * @param array<string, mixed> $remote
 *   Result from RemoteReplica::getRemoteSize().
 */
function drx_litestream_format_remote_size_for_requirements(array $remote): string {
  if (empty($remote['available'])) {
    return (string) ($remote['error'] ?? '—');
  }

  $bytes = (int) ($remote['bytes'] ?? 0);
  $objects = (int) ($remote['objects'] ?? 0);
  $units = ['B', 'KiB', 'MiB', 'GiB', 'TiB', 'PiB'];
  $i = 0;
  $v = (float) $bytes;
  while ($v >= 1024 && $i < count($units) - 1) {
    $v /= 1024;
    $i++;
  }

  return sprintf('%.2f %s (%d objects)', $v, $units[$i], $objects);
}
