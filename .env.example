# Drupal admin credentials for local development.
DRUPAL_ADMIN_USER=admin
# Required: set a local-only admin password before starting the backend.
DRUPAL_ADMIN_PASS=

# Optional Drupal site display name.
DRUPAL_SITE_NAME=DrX Application

# Canonical public URLs.
BACKEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# Optional override for the schema directory used by DrX-Schema commands.
# Relative paths resolve from the directory containing the active .env file.
DRX_SCHEMA_PATH=schema/v2

# Production-only override for allowing multiple frontend origins.
# Leave blank for local/dev so CORS follows FRONTEND_URL.
CORS_ALLOWED_ORIGINS=

# Local litestream + MinIO defaults used by server/docker-compose.yml.
# Keep these for local DR drills and module testing; production should
# point DRX_LITESTREAM_* at a real S3-compatible backend and use
# non-default credentials.
DRX_LITESTREAM_ENABLED=1
DRX_LITESTREAM_REPLICA_URL=s3://drx-backups/server
DRX_LITESTREAM_ENDPOINT=http://minio:9000
DRX_LITESTREAM_REGION=us-east-1
DRX_LITESTREAM_BUCKET=drx-backups

# Local MinIO bootstrap credentials (for compose minio + minio-init).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin